# ====================================================================
# NOIR PLATFORM ENVIRONMENT CONFIGURATION
# ====================================================================

# App configuration
NEXT_PUBLIC_APP_NAME="NOIR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (PostgreSQL Database & Realtime Auth)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Razorpay Payments (Indian Payment Gateway)
# Test credentials can be obtained at https://dashboard.razorpay.com
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_samplekey123"
RAZORPAY_KEY_SECRET="your_sample_secret_key"

# Mapbox / Location Services (Optional, Leaflet fallback enabled)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Node Environment
NODE_ENV="development"
